eval ux_group=if(native_kind="auditd" AND session_remote_access="remote",event_host."|".audit_session."|".login_uid,"isolated:".event_key)
| eventstats min(eval(if(session_remote_access="remote" AND mvfind(audit_record_types,"^USER_LOGIN$")>=0,event_time,null()))) AS ux_start max(eval(if(session_remote_access="remote" AND mvfind(audit_record_types,"^USER_LOGOUT$")>=0,event_time,null()))) AS ux_end BY ux_group
| eval ux_candidate=if(native_kind="auditd" AND session_remote_access="remote" AND mvfind(audit_record_types,"^USER_LOGIN$")>=0 AND isnotnull(ux_start) AND isnotnull(ux_end) AND ux_start<ux_end,json_object("start",ux_start,"end",ux_end,"user",coalesce(login_user,"uid:".login_uid),"uid",login_uid,"session",audit_session,"source_ip",session_source_ip,"terminal",terminal,"event_proofs",mvjoin(mvsort(session_context_fingerprints),","),"record_proofs",mvjoin(mvsort(session_context_record_fingerprints),",")),null())
| eventstats values(ux_candidate) AS ux_candidates BY event_host
| eval usb_session_evidence=if(native_kind="kernel-usb",mvmap(ux_candidates,if(event_time>=tonumber(json_extract(ux_candidates,"start")) AND event_time<tonumber(json_extract(ux_candidates,"end")),ux_candidates,null())),null())
| eval usb_session_count=if(native_kind="kernel-usb",coalesce(mvcount(usb_session_evidence),0),null()), usb_session_users=mvmap(usb_session_evidence,tostring(json_extract(usb_session_evidence,"user"))), usb_session_details=mvmap(usb_session_evidence,json_extract(usb_session_evidence,"user")." (UID ".json_extract(usb_session_evidence,"uid").", SSH session ".json_extract(usb_session_evidence,"session").", source ".json_extract(usb_session_evidence,"source_ip").", terminal ".json_extract(usb_session_evidence,"terminal").")")
| eval usb_session_status=case(native_kind!="kernel-usb",null(),usb_session_count>1,"Multiple overlapping closed SSH sessions — physical actor unknown",usb_session_count=1,"One overlapping closed SSH session — physical actor unknown",true(),"No qualifying closed SSH session in selected window — not proof of no logged-in users"), usb_session_basis=if(native_kind="kernel-usb","Context only: same-host bounded successful LOGIN/sshd USER_LOGIN/USER_LOGOUT evidence. Open sessions and local-console sessions are not inferred. No observed boot/shutdown within interval; absent logs can hide boundaries. Never fills actor, initiator, terminal, privilege or AU-3 checks.",null())
| fields - ux_*
