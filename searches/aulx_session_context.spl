eventstats values(eval(if(mvfind(audit_record_types,"^SYSTEM_(BOOT|SHUTDOWN)$")>=0,event_time,null()))) AS ctx_boundary_times BY event_host
| eval ctx_eligible=if(mvcount(event_host)=1 AND len(event_host)>0 AND mvcount(native_kind)=1 AND native_kind="auditd" AND mvcount(audit_session)=1 AND mvcount(login_uid)=1 AND match(audit_session,"^[0-9]+$") AND match(login_uid,"^[0-9]+$") AND NOT in(audit_session,"4294967295","-1") AND NOT in(login_uid,"4294967295","-1"),1,0)
| eval ctx_group=if(ctx_eligible=1,event_host."|".audit_session."|".login_uid,"isolated:".event_key), ctx_ssh=if(in(application,"/usr/sbin/sshd","/usr/libexec/openssh/sshd-session"),1,0)
| eval ctx_anchor=if(ctx_eligible=1 AND mvfind(audit_record_types,"^LOGIN$")>=0 AND outcome="success",1,0), ctx_start=if(ctx_eligible=1 AND ctx_ssh=1 AND mvfind(audit_record_types,"^USER_LOGIN$")>=0 AND outcome="success",1,0), ctx_end=if(ctx_eligible=1 AND ctx_ssh=1 AND mvfind(audit_record_types,"^USER_LOGOUT$")>=0 AND outcome="success",1,0)
| eventstats sum(ctx_anchor) AS ctx_anchors sum(ctx_start) AS ctx_starts sum(ctx_end) AS ctx_ends values(eval(if(ctx_anchor=1,event_time,null()))) AS ctx_anchor_time values(eval(if(ctx_start=1,event_time,null()))) AS ctx_start_time values(eval(if(ctx_end=1,event_time,null()))) AS ctx_end_time values(eval(if(ctx_start=1,process_id,null()))) AS ctx_start_pid values(eval(if(ctx_end=1,process_id,null()))) AS ctx_end_pid values(eval(if(ctx_start=1,source_ip,null()))) AS ctx_address values(eval(if(ctx_start=1,terminal,null()))) AS ctx_start_terminal values(eval(if(ctx_end=1,terminal,null()))) AS ctx_end_terminal values(eval(if(ctx_anchor=1 OR ctx_start=1 OR ctx_end=1,event_fingerprint,null()))) AS ctx_fingerprints values(eval(if(ctx_anchor=1 OR ctx_start=1 OR ctx_end=1,record_fingerprint,null()))) AS ctx_record_fingerprints BY ctx_group
| eval ctx_start_terminal=replace(replace(ctx_start_terminal,"^/dev/",""),"^pts/","pts"), ctx_end_terminal=replace(replace(ctx_end_terminal,"^/dev/",""),"^pts/","pts"), ctx_event_terminal=replace(replace(terminal,"^/dev/",""),"^pts/","pts")
| eval ctx_boundary_hits=mvmap(ctx_boundary_times,if(ctx_boundary_times>=ctx_anchor_time AND ctx_boundary_times<=ctx_end_time,ctx_boundary_times,null()))
| eval ctx_boundary_count=coalesce(mvcount(ctx_boundary_hits),0)
| eval ctx_match=if(ctx_boundary_count=0 AND mvcount(ctx_fingerprints)=3 AND mvcount(ctx_end_pid)=1 AND mvcount(ctx_start_terminal)=1 AND mvcount(ctx_end_terminal)=1 AND mvcount(ctx_event_terminal)=1 AND ctx_eligible=1 AND ctx_anchors=1 AND ctx_starts=1 AND ctx_ends=1 AND mvcount(ctx_start_pid)=1 AND ctx_start_pid=ctx_end_pid AND mvcount(ctx_address)=1 AND (cidrmatch("0.0.0.0/0",ctx_address) OR cidrmatch("::/0",ctx_address)) AND ctx_start_terminal=ctx_end_terminal AND ctx_event_terminal=ctx_start_terminal AND ctx_anchor_time<=ctx_start_time AND ctx_start_time-ctx_anchor_time<=60 AND ctx_start_time<=event_time AND event_time<=ctx_end_time AND ctx_end_time-ctx_start_time<=86400,1,0)
| eval session_remote_access=if(ctx_match=1,"remote",null()), session_source_ip=if(ctx_match=1,ctx_address,null()), session_context_fingerprints=if(ctx_match=1,ctx_fingerprints,null()), session_context_record_fingerprints=if(ctx_match=1,ctx_record_fingerprints,null()), session_context_basis=if(ctx_match=1,"Bounded LOGIN + successful sshd USER_LOGIN/USER_LOGOUT; same host/session/login UID/PID/terminal. Login-session origin, not proof of a current network operation; no observed boot/shutdown boundary inside the interval. Missing lifecycle records can hide a boundary; boot continuity still requires review.",null())
| eval session_context_status=case(ctx_match=1,"Correlated session origin — boot continuity not verified",ctx_boundary_count>0 AND ctx_starts>0 AND ctx_ends>0,"Rejected — observed boot/shutdown boundary",true(),"No unambiguous closed SSH session in selected window")
| fields - ctx_*
