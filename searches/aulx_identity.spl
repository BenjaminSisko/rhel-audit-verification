rex field=lx_raw "(?<lx_enriched>(?:(?:^|[\s\x1d])[A-Z][A-Z0-9_]*=(?:\"[^\"]*\"|[^\s]+))+)$"
| rex field=lx_enriched "(?:^|[\s\x1d])AUID=\"?(?<lx_auid_name>[^\s\"]+)"
| rex field=lx_enriched "(?:^|[\s\x1d])UID=\"?(?<lx_uid_name>[^\s\"]+)"
| rex field=lx_enriched "(?:^|[\s\x1d])EUID=\"?(?<lx_euid_name>[^\s\"]+)"
| rex field=lx_enriched "(?:^|[\s\x1d])ID=\"?(?<lx_target_name>[^\s\"]+)"
| foreach lx_acct lx_target_id lx_target_name lx_auid_name lx_uid_name lx_euid_name [ eval <<FIELD>>=if(in(lower('<<FIELD>>'),"unknown","(unknown)","unset","(unset)","(null)","(none)","?","-","4294967295","-1",""),null(),'<<FIELD>>') ]
| eval login_user=if(isnotnull(lx_type) AND isnotnull(lx_auid) AND NOT in(lx_auid,"-1","4294967295"),coalesce(lx_auid_name,"uid:".lx_auid),null()), process_user=if(isnotnull(lx_type) AND isnotnull(lx_uid) AND NOT in(lx_uid,"-1","4294967295"),coalesce(lx_uid_name,"uid:".lx_uid),null()), effective_user=if(isnotnull(lx_type) AND isnotnull(lx_euid) AND NOT in(lx_euid,"-1","4294967295"),coalesce(lx_euid_name,"euid:".lx_euid),null()), target_account=if(isnotnull(lx_type),coalesce(lx_acct,if(in(lx_type,"USER_AUTH","USER_LOGIN","USER_LOGOUT") AND match(lx_target_id,"^[0-9]+$"),coalesce(lx_target_name,"uid:".lx_target_id),lx_target_id)),coalesce(lx_ssh_user,lx_pam_user))
| eval actor=if(isnotnull(lx_type),if(in(lx_type,"USER_AUTH","USER_LOGIN"),target_account,coalesce(login_user,process_user)),actor), initiator=if(isnotnull(lx_type),login_user,initiator), completer=if(isnotnull(lx_type),coalesce(effective_user,process_user),completer)
| eval identity_basis=case(isnotnull(lx_type) AND in(lx_type,"USER_AUTH","USER_LOGIN"),"Reported authentication account; not proof of the human actor",isnotnull(login_user),"Source audit login identity",isnotnull(lx_type) AND isnotnull(process_user),"Process identity only; login user not recorded",isnotnull(lx_json_actor),"Application-reported identity",isnotnull(lx_ssh_user),"SSH-reported account",isnotnull(lx_pam_user),"PAM session account; original login identity not established",true(),"User not recorded")
