spath
| `aulx_usb`
| eval lx_raw=coalesce(full_log,_raw), lx_json_action='event.action', lx_json_outcome=lower('event.outcome'), lx_json_actor='user.name', lx_json_app='service.name', lx_json_object='object.name', lx_json_time=coalesce(timestamp,'@timestamp'), lx_json_id=coalesce('event.id','request.id','trace.id'), lx_json_initiator='event.initiator', lx_json_completer='event.completer', lx_json_remote=lower(tostring('event.remote')), lx_json_terminal='terminal.id', lx_json_privilege='user.effective.id', lx_json_reason=coalesce('event.reason','event.code')
| rex field=lx_raw "(?:^|\s)node=(?<lx_node>[^\s]+)"
| rex field=lx_raw "(?:^|\s)type=(?<lx_type>[A-Z_]+)"
| rex field=lx_raw "audit\((?<lx_epoch>[0-9]+[.][0-9]+):(?<lx_serial>[0-9]+)\)"
| rex field=lx_raw "(?:^|\s)arch=(?<lx_arch>[0-9a-fA-F]+)"
| rex field=lx_raw "(?:^|\s)syscall=(?<lx_syscall>[0-9A-Za-z_]+)"
| rex field=lx_raw "(?:^|\s)success=(?<lx_success>yes|no)"
| rex field=lx_raw "(?:^|\s)res=['\"]?(?<lx_res>success|failed|failure|denied|yes|no|1|0)(?:['\"\s]|$)"
| rex field=lx_raw "(?:^|\s)auid=(?<lx_auid>[0-9-]+)"
| rex field=lx_raw "(?:^|\s)uid=(?<lx_uid>[0-9-]+)"
| rex field=lx_raw "(?:^|\s)euid=(?<lx_euid>[0-9-]+)"
| rex field=lx_raw "(?:^|\s)acct=['\"]?(?<lx_acct>[^\s'\"]+)"
| rex field=lx_raw "(?:^|\s)exe=\"(?<lx_exe>[^\"]+)\""
| rex field=lx_raw "(?:^|\s)comm=\"(?<lx_comm>[^\"]+)\""
| rex field=lx_raw "(?:^|\s)name=\"(?<lx_path>[^\"]+)\""
| rex field=lx_raw "(?:^|\s)nametype=(?<lx_nametype>[A-Z_]+)"
| eval lx_path=if(lx_type="PATH" AND lx_nametype="PARENT",null(),lx_path)
| rex field=lx_raw "(?:^|\s)key=\"?(?<lx_key>[^\s\"]+)"
| rex field=lx_raw "(?:^|\s)addr=(?<lx_addr>[0-9a-fA-F:.]+)"
| rex field=lx_raw "(?:^|\s)(?:terminal|tty)=['\"]?(?<lx_terminal>[^\s'\"]+)"
| rex field=lx_raw "(?:^|\s)ses=(?<lx_session>[0-9]+)"
| rex field=lx_raw "(?:^|\s)pid=(?<lx_pid>[0-9]+)"
| rex field=lx_raw "(?:^|\s)exit=(?<lx_exit>-?[0-9]+)"
| rex field=lx_raw "(?:^|\s)id=(?<lx_target_id>[A-Za-z0-9_.:@+-]+)"
| rex field=lx_raw "(?:^|[\s'])op=(?<lx_op>[^']*?)(?:\s+(?:acct|id|exe|hostname|addr|terminal|res)=|')"
| rex field=lx_raw "sshd(?:-session)?(?:\[[0-9]+\])?: (?<lx_ssh_status>Accepted|Failed) [^ ]+ for (?:invalid user )?(?<lx_ssh_user>[^ ]+) from (?<lx_ssh_src>[^ ]+)"
| rex field=lx_raw "sshd(?:-session)?(?:\[[0-9]+\])?: Invalid user (?<lx_ssh_invalid_user>[^ ]+) from (?<lx_ssh_invalid_src>[^ ]+)"
| eval lx_ssh_status=coalesce(lx_ssh_status,if(isnotnull(lx_ssh_invalid_user),"Failed",null())), lx_ssh_user=coalesce(lx_ssh_user,lx_ssh_invalid_user), lx_ssh_src=coalesce(lx_ssh_src,lx_ssh_invalid_src)
| rex field=lx_raw "pam_unix\((?<lx_pam_app>[^:]+):session\): session (?<lx_pam_state>opened|closed) for user (?<lx_pam_user>[^\s(]+)"
| rex field=lx_raw "(?:^|\s)(?<lx_syslog_app>[A-Za-z][A-Za-z0-9_.-]+)\[(?<lx_syslog_pid>[0-9]+)\]:"
| eval event_host=coalesce(lx_node,'agent.name','host.name',host), application=if(isnotnull(lx_type),coalesce(lx_exe,lx_comm),coalesce(lx_json_app,lx_pam_app,lx_syslog_app)), source_ip=coalesce('source.ip',lx_ssh_src,lx_addr), actor=coalesce(lx_json_actor,lx_acct,lx_ssh_user,lx_pam_user,if(isnotnull(lx_auid) AND NOT in(lx_auid,"-1","4294967295"),"uid:".lx_auid,null()),if(isnotnull(lx_uid),"uid:".lx_uid,null())), initiator=coalesce(lx_json_initiator,if(isnotnull(lx_auid) AND NOT in(lx_auid,"-1","4294967295"),"uid:".lx_auid,null()),lx_ssh_user,lx_pam_user), completer=coalesce(lx_json_completer,if(isnotnull(lx_euid),"euid:".lx_euid,if(isnotnull(lx_uid),"uid:".lx_uid,null()))), object=coalesce(lx_json_object,lx_path,if(isnotnull(lx_ssh_invalid_user),"account:".lx_ssh_invalid_user,null())), terminal=coalesce(lx_json_terminal,lx_terminal,if(isnotnull(lx_ssh_invalid_user),"ssh",null())), privilege=coalesce(lx_json_privilege,lx_euid,lx_uid), correlation_id=coalesce(lx_json_id,if(isnotnull(lx_epoch),lx_epoch.":".lx_serial,null()),lx_session,if(isnotnull(lx_ssh_invalid_user),lx_syslog_pid,null())), process_id=coalesce(lx_pid,lx_syslog_pid), reason=coalesce(lx_json_reason,if(isnotnull(lx_ssh_invalid_user),"Invalid user",null()),lx_exit), source_timestamp=coalesce(lx_epoch,lx_json_time), operation=lx_op
| eval actor=if(isnotnull(lx_type),coalesce(if(in(lx_type,"USER_AUTH","USER_LOGIN","USER_LOGOUT"),lx_acct,null()),if(isnotnull(lx_auid) AND NOT in(lx_auid,"-1","4294967295"),"uid:".lx_auid,null()),if(isnotnull(lx_uid),"uid:".lx_uid,null())),actor), object=coalesce(object,if(in(lx_type,"ADD_USER","DEL_USER","USER_CHAUTHTOK","CHUSER_ID"),"account:".coalesce(lx_acct,lx_target_id),null()),if(in(lx_type,"ADD_GROUP","DEL_GROUP","CHGRP_ID"),"group:".coalesce(lx_acct,lx_target_id),null()),if(in(lx_type,"SYSTEM_BOOT","SYSTEM_SHUTDOWN"),"operating-system:".event_host,null()))
| `aulx_identity`
| eval object=coalesce(object,if(in(lx_type,"USER_AUTH","USER_LOGIN","USER_LOGOUT"),"account:".target_account,null()))
| eval object=coalesce(object,if(in(lx_type,"USER_MGMT","ACCT_LOCK"),"account:".coalesce(lx_acct,lx_target_id),null()),if(lx_type="GRP_MGMT","group:".coalesce(lx_acct,lx_target_id),null()))
| eval outcome=case(in(lx_success,"yes"),"success",in(lx_success,"no"),"failure",in(lx_res,"success","yes","1"),"success",in(lx_res,"failed","failure","denied","no","0"),"failure",in(lx_json_outcome,"success","succeeded","allowed"),"success",in(lx_json_outcome,"failure","failed","denied","error"),"failure",lx_ssh_status="Accepted","success",lx_ssh_status="Failed","failure",in(lx_pam_state,"opened","closed"),"success",true(),null()), remote_access=case(in(lx_json_remote,"true","yes","1"),"remote",in(lx_json_remote,"false","no","0"),"local",isnotnull(lx_ssh_src) OR isnotnull(source_ip),"remote",match(lx_terminal,"^(/dev/)?(tty[0-9]+|console)$"),"local",true(),null())
| lookup aulx_syscalls.csv arch AS lx_arch syscall AS lx_syscall OUTPUT syscall_name
| eval syscall_name=coalesce(syscall_name,if(match(lx_syscall,"^[a-z][a-z0-9_]+$"),lx_syscall,null())), native_kind=case(isnotnull(lx_serial) AND isnotnull(lx_type),"auditd",isnotnull(lx_ssh_status) OR isnotnull(lx_pam_state),"auth",sourcetype="linux_app_audit" AND isnotnull(lx_json_action),"application-json",true(),"unsupported"), record_fingerprint=sha256(coalesce(index,"")."|".coalesce(event_host,"")."|".coalesce(source,"")."|".tostring(_time)."|"._raw), event_key=if(native_kind="auditd",event_host."|audit|".lx_epoch.":".lx_serial,record_fingerprint)
| rex field=lx_raw "^(?<lx_syslog_timestamp>(?:[A-Z][a-z]{2}\s+[0-9]+\s+[0-9:]+)|(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[^ ]+))"
| eval source_timestamp=coalesce(source_timestamp,lx_syslog_timestamp), event_time=_time, ingest_time=_indextime
| eval event_host=if(isnotnull(lx_usb_port),lx_usb_host,event_host), application=if(isnotnull(lx_usb_port),"kernel",application), native_kind=if(isnotnull(lx_usb_port),"kernel-usb",native_kind), event_key=if(isnotnull(lx_usb_port),coalesce(lx_usb_join,record_fingerprint),event_key), source_timestamp=if(isnotnull(lx_usb_port),tostring(_time),source_timestamp), outcome=if(isnotnull(lx_usb_port),if(isnotnull(lx_usb_action),"success",null()),outcome), object=if(isnotnull(lx_usb_port),"USB port ".lx_usb_port,object), correlation_id=if(isnotnull(lx_usb_port),event_key,correlation_id)
| foreach actor initiator completer login_user process_user effective_user target_account terminal privilege source_ip remote_access process_id reason operation syscall_name lx_type lx_key lx_json_action lx_pam_state lx_ssh_status lx_arch lx_syscall lx_uid lx_euid lx_auid lx_target_id [ eval <<FIELD>>=if(isnotnull(lx_usb_port),null(),'<<FIELD>>') ]
| eval identity_basis=if(isnotnull(lx_usb_port),"User not recorded by kernel USB observation",identity_basis)
| fields _raw _time _indextime host _bkt _cd splunk_server event_key event_time ingest_time index source sourcetype event_host application source_ip actor initiator completer login_user process_user effective_user target_account identity_basis object terminal privilege correlation_id process_id reason operation source_timestamp outcome remote_access native_kind record_fingerprint syscall_name lx_type lx_key lx_json_action lx_pam_state lx_ssh_status lx_arch lx_syscall lx_session lx_uid lx_euid lx_auid lx_target_id lx_usb_action lx_usb_port lx_usb_vendor lx_usb_product_id lx_usb_product lx_usb_manufacturer lx_usb_driver
