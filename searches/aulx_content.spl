foreach actor application object initiator completer terminal privilege correlation_id source_timestamp source_ip reason [ eval <<FIELD>>=if(in(lower(tostring('<<FIELD>>')),"unknown","(null)","(none)","?","-","","unset"),null(),'<<FIELD>>') ]
| eval au3_missing=mvappend(if(event_action="Unmapped event","event type/action",null()),if(isnull(source_timestamp),"source event date/time",null()),if(isnull(event_host) OR in(event_host,"unknown","localhost"),"event location/host",null()),if(isnull(source) OR isnull(sourcetype),"log source/collector path",null()),if(isnull(actor),"user/subject identity",null()),if(NOT in(outcome,"success","failure"),"explicit outcome",null()))
| eval au3_1_missing=mvappend(if(isnull(terminal),"terminal/workstation identity",null()),if(isnull(remote_access),"remote/local access context",null()),if(isnull(initiator),"initiating entity",null()),if(isnull(completer),"completing entity",null()))
| eval application_missing=mvappend(if(isnull(application),"application/service/executable",null()),if(isnull(object),"target object/resource",null()),if(isnull(correlation_id),"event/session/request correlation",null()),if(isnull(privilege),"effective privilege context",null()),if(outcome="failure" AND isnull(reason),"failure reason/return code",null()))
| eval au3_complete=if(coalesce(mvcount(au3_missing),0)=0,1,0), au3_1_complete=if(coalesce(mvcount(au3_1_missing),0)=0,1,0), app_context_complete=if(coalesce(mvcount(application_missing),0)=0,1,0), field_check_complete=if(au3_complete=1 AND au3_1_complete=1 AND app_context_complete=1,1,0), missing_fields=mvappend(au3_missing,au3_1_missing,application_missing), age_seconds=now()-event_time, delivery_delay_seconds=ingest_time-event_time
| eval content_status=if(field_check_complete=1,"Required fields present — semantic review required","Content incomplete"), capture_status=if(case_id="UNMAPPED","Record captured; mapping incomplete","Candidate event captured"), missing_fields=coalesce(missing_fields,"None under current field-presence profile"), clock_status="Not verified by record presence", protection_status="Original Splunk reference available; integrity/retention not assessed"
| lookup aulx_verification_receipts event_host application case_id event_fingerprint OUTPUT receipt_id generated_utc received_utc source_evidence_ref reviewer reviewed_utc expires_utc review_result content_review mapping_review
| eval reviewed_epoch=strptime(reviewed_utc,"%Y-%m-%dT%H:%M:%SZ"), expires_epoch=strptime(expires_utc,"%Y-%m-%dT%H:%M:%SZ"), verification_status=case(review_result="rejected","Failed reviewed test",review_result="accepted" AND field_check_complete=1 AND content_review="accepted" AND mapping_review="accepted" AND len(reviewer)>0 AND len(receipt_id)>0 AND len(source_evidence_ref)>0 AND isnotnull(strptime(generated_utc,"%Y-%m-%dT%H:%M:%SZ")) AND isnotnull(strptime(received_utc,"%Y-%m-%dT%H:%M:%SZ")) AND reviewed_epoch<=now() AND expires_epoch>now(),"Verified test receipt",true(),"Not yet verified")
