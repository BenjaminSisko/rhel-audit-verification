stats min(event_time) AS event_time max(ingest_time) AS ingest_time count AS raw_records values(index) AS index values(source) AS source values(sourcetype) AS sourcetype values(event_host) AS event_host values(application) AS application values(source_ip) AS source_ip values(actor) AS actor values(login_user) AS login_user values(process_user) AS process_user values(effective_user) AS effective_user values(target_account) AS target_account values(identity_basis) AS identity_basis values(lx_uid) AS process_uid values(initiator) AS initiator values(completer) AS completer values(object) AS object values(terminal) AS terminal values(privilege) AS privilege values(correlation_id) AS correlation_id values(process_id) AS process_id values(reason) AS reason values(operation) AS operation values(source_timestamp) AS source_timestamp values(outcome) AS outcomes values(remote_access) AS remote_access values(native_kind) AS native_kind values(record_fingerprint) AS record_fingerprint values(syscall_name) AS syscall_name values(lx_type) AS audit_record_types values(lx_key) AS audit_keys values(lx_json_action) AS json_action values(lx_pam_state) AS pam_state values(lx_ssh_status) AS ssh_status values(lx_arch) AS architecture values(lx_syscall) AS syscall_number values(lx_euid) AS effective_uid values(lx_auid) AS login_uid values(lx_target_id) AS target_id values(lx_usb_action) AS usb_action values(lx_usb_port) AS usb_port values(lx_usb_vendor) AS usb_vendor values(lx_usb_product_id) AS usb_product_id values(lx_usb_product) AS usb_product values(lx_usb_manufacturer) AS usb_manufacturer values(lx_usb_driver) AS usb_driver BY event_key
| eval outcome=if(mvcount(outcomes)=1,mvindex(outcomes,0),"unknown"), application=if(mvcount(application)=1,mvindex(application,0),mvjoin(application,"; ")), event_fingerprint=sha256(mvjoin(mvsort(record_fingerprint),"|")), correlation_state=case(native_kind="auditd" AND mvfind(audit_record_types,"^SYSCALL$")>=0 AND mvfind(audit_record_types,"^EXECVE$")>=0,"Related syscall/execution records joined",native_kind="auditd","Audit records grouped; completeness not asserted",true(),"Single source record"), _time=event_time
| eval object=if(native_kind="kernel-usb",mvjoin(mvappend(object,usb_product,usb_manufacturer,if(isnotnull(usb_vendor),"vendor:".usb_vendor,null()),if(isnotnull(usb_product_id),"product:".usb_product_id,null())),"; "),object), correlation_state=if(native_kind="kernel-usb" AND raw_records>1,"USB port/boot/device-number sequence within 5 seconds; bounded context, not completeness proof",correlation_state)
